<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aroot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="6dp">
        <TextView android:id="@+id/atitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Agenda" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/widget_text" />
        <TextView android:id="@+id/arefresh" android:layout_width="32dp" android:layout_height="32dp"
            android:gravity="center" android:text="↻" android:textSize="20sp" android:textColor="@color/widget_accent" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_line" />

    <LinearLayout android:id="@+id/ar0" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="5dp" android:paddingBottom="5dp" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/ad0" android:layout_width="62dp" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_accent" />
        <TextView android:id="@+id/at0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/ar1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="5dp" android:paddingBottom="5dp" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/ad1" android:layout_width="62dp" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_accent" />
        <TextView android:id="@+id/at1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/ar2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="5dp" android:paddingBottom="5dp" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/ad2" android:layout_width="62dp" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_accent" />
        <TextView android:id="@+id/at2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/ar3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="5dp" android:paddingBottom="5dp" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/ad3" android:layout_width="62dp" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_accent" />
        <TextView android:id="@+id/at3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/ar4" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="5dp" android:paddingBottom="5dp" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/ad4" android:layout_width="62dp" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_accent" />
        <TextView android:id="@+id/at4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/ar5" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="5dp" android:paddingBottom="5dp" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/ad5" android:layout_width="62dp" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold" android:textColor="@color/widget_accent" />
        <TextView android:id="@+id/at5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="@color/widget_text" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/aempty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="10dp" android:textSize="13sp" android:textColor="@color/widget_text2" android:visibility="gone" />
    <TextView android:id="@+id/afoot" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="6dp" android:textSize="10sp" android:textColor="@color/widget_text2" />
</LinearLayout>
