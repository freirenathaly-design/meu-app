<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aroot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg"
    android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="8dp" android:paddingBottom="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/atitle" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Agenda" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/widget_text" />
        <TextView android:id="@+id/aprev" android:layout_width="38dp" android:layout_height="38dp"
            android:gravity="center" android:text="‹" android:textSize="26sp" android:textColor="@color/widget_text" />
        <TextView android:id="@+id/anext" android:layout_width="38dp" android:layout_height="38dp"
            android:gravity="center" android:text="›" android:textSize="26sp" android:textColor="@color/widget_text" />
        <TextView android:id="@+id/aplus" android:layout_width="38dp" android:layout_height="38dp"
            android:layout_marginLeft="4dp" android:background="@drawable/btn_plus_bg"
            android:gravity="center" android:text="+" android:textSize="24sp" android:textColor="#FFFFFF" />
    </LinearLayout>

    <ImageView android:id="@+id/acal" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="58" android:scaleType="fitXY" />

    <LinearLayout android:id="@+id/alist" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="42" android:orientation="vertical" android:paddingTop="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_line" />
        <TextView android:id="@+id/ahoje" android:layout_width="match_parent" android:layout_height="18dp"
            android:gravity="center_vertical" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/widget_text2" />
        <LinearLayout android:id="@+id/ar0" android:layout_width="match_parent" android:layout_height="20dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/ah0" android:layout_width="52dp" android:layout_height="wrap_content"
                android:textSize="11sp" android:textStyle="bold" android:textColor="@color/widget_accent" android:maxLines="1" />
            <TextView android:id="@+id/at0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ar1" android:layout_width="match_parent" android:layout_height="20dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/ah1" android:layout_width="52dp" android:layout_height="wrap_content"
                android:textSize="11sp" android:textStyle="bold" android:textColor="@color/widget_accent" android:maxLines="1" />
            <TextView android:id="@+id/at1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ar2" android:layout_width="match_parent" android:layout_height="20dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/ah2" android:layout_width="52dp" android:layout_height="wrap_content"
                android:textSize="11sp" android:textStyle="bold" android:textColor="@color/widget_accent" android:maxLines="1" />
            <TextView android:id="@+id/at2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ar3" android:layout_width="match_parent" android:layout_height="20dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/ah3" android:layout_width="52dp" android:layout_height="wrap_content"
                android:textSize="11sp" android:textStyle="bold" android:textColor="@color/widget_accent" android:maxLines="1" />
            <TextView android:id="@+id/at3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:id="@+id/ar4" android:layout_width="match_parent" android:layout_height="20dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/ah4" android:layout_width="52dp" android:layout_height="wrap_content"
                android:textSize="11sp" android:textStyle="bold" android:textColor="@color/widget_accent" android:maxLines="1" />
            <TextView android:id="@+id/at4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/widget_text" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/avazio" android:layout_width="match_parent" android:layout_height="20dp"
            android:gravity="center_vertical" android:text="Nada marcado para hoje." android:textSize="12sp"
            android:textColor="@color/widget_text2" android:visibility="gone" />
    </LinearLayout>

    <TextView android:id="@+id/afoot" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="3dp" android:textSize="9sp" android:textColor="@color/widget_text2" />
</LinearLayout>
